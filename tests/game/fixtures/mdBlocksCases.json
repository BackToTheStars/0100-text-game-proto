      "blocks": [
        "1\\. Not a list item.\nSecond line."
      ]
    },
    {
      "name": "fenced code with blank lines is one block",
      "source": "```js\nconst a = 1;\n\nconst b = 2;\n```",
      "blocks": [
        "```js\nconst a = 1;\n\nconst b = 2;\n```"
      ]
    },
    {
      "name": "blockquote with an empty quoted line is one block",
