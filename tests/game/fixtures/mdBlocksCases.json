        "| a | b |\n| - | - |\n| 1 | 2 |\n| 3 | 4 |"
      ]
    },
    {
      "name": "thematic break between paragraphs",
      "source": "Above.\n\n---\n\nBelow.",
      "blocks": [
        "Above.",
        "---",
        "Below."
      ]
